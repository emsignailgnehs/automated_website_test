---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Bright & Co. — Modern Solutions for Your Business">

  <!-- Navigation -->
  <header>
    <nav class="navbar">
      <div class="container nav-inner">
        <a href="#hero" class="logo">Bright <span>&amp;</span> Co.</a>
        <ul class="nav-links">
          <li><a href="#about">About</a></li>
          <li><a href="#services">Services</a></li>
          <li><a href="#team">Team</a></li>
          <li><a href="#contact" class="btn-nav">Contact Us</a></li>
        </ul>
      </div>
    </nav>
  </header>

  <!-- Hero Section -->
  <section id="hero" class="hero">
    <div class="container hero-inner">
      <div class="hero-content">
        <span class="badge">Small Business · Big Results</span>
        <h1>We Help Your Business <span class="highlight">Shine</span></h1>
        <p>
          Bright &amp; Co. is a full-service consulting firm dedicated to helping
          local businesses grow with modern strategies, smart tools, and
          personalised support.
        </p>
        <div class="hero-actions">
          <a href="#contact" class="btn-primary">Get in Touch</a>
          <a href="#services" class="btn-outline">Our Services</a>
        </div>
      </div>
      <div class="hero-graphic" aria-hidden="true">
        <div class="graphic-circle c1"></div>
        <div class="graphic-circle c2"></div>
        <div class="graphic-icon">✦</div>
      </div>
    </div>
  </section>

  <!-- About Section -->
  <section id="about">
    <div class="container">
      <h2 class="section-title">About Us</h2>
      <p class="section-subtitle">Who we are and what drives us</p>
      <div class="about-grid">
        <div class="about-text">
          <p>
            Founded in 2018, <strong>Bright &amp; Co.</strong> started with a
            simple idea: every small business deserves access to the same
            quality tools and expertise as the big players.
          </p>
          <p>
            We partner with entrepreneurs, sole traders, and growing teams to
            streamline operations, sharpen branding, and unlock new revenue
            opportunities — without the enterprise price tag.
          </p>
          <ul class="about-highlights">
            <li>✅ 200+ businesses served</li>
            <li>✅ Award-winning customer support</li>
            <li>✅ No long-term contracts</li>
          </ul>
        </div>
        <div class="about-stats">
          <div class="stat-card">
            <span class="stat-number">200+</span>
            <span class="stat-label">Happy Clients</span>
          </div>
          <div class="stat-card">
            <span class="stat-number">7</span>
            <span class="stat-label">Years in Business</span>
          </div>
          <div class="stat-card">
            <span class="stat-number">98%</span>
            <span class="stat-label">Satisfaction Rate</span>
          </div>
          <div class="stat-card">
            <span class="stat-number">15</span>
            <span class="stat-label">Team Members</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Services Section -->
  <section id="services">
    <div class="container">
      <h2 class="section-title">Our Services</h2>
      <p class="section-subtitle">Everything you need to grow, in one place</p>
      <div class="services-grid">
        <div class="service-card">
          <div class="service-icon">🚀</div>
          <h3>Business Strategy</h3>
          <p>
            Tailored growth plans built around your goals, your market, and
            your budget — no one-size-fits-all templates.
          </p>
        </div>
        <div class="service-card">
          <div class="service-icon">🎨</div>
          <h3>Brand Identity</h3>
          <p>
            Logo design, colour palettes, and brand guidelines that tell your
            story and stick in customers' minds.
          </p>
        </div>
        <div class="service-card">
          <div class="service-icon">💻</div>
          <h3>Web &amp; Digital</h3>
          <p>
            Fast, accessible websites and digital storefronts that convert
            visitors into loyal customers.
          </p>
        </div>
        <div class="service-card">
          <div class="service-icon">📣</div>
          <h3>Marketing</h3>
          <p>
            Social media management, email campaigns, and local SEO to put
            your business in front of the right people.
          </p>
        </div>
        <div class="service-card">
          <div class="service-icon">📊</div>
          <h3>Analytics &amp; Reporting</h3>
          <p>
            Clear dashboards and monthly reports so you always know what's
            working — and what to do next.
          </p>
        </div>
        <div class="service-card">
          <div class="service-icon">🤝</div>
          <h3>Ongoing Support</h3>
          <p>
            Dedicated account managers available via phone, email, and chat
            whenever you need a hand.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Team Section -->
  <section id="team">
    <div class="container">
      <h2 class="section-title">Meet the Team</h2>
      <p class="section-subtitle">The people behind your success</p>
      <div class="team-grid">
        <div class="team-card">
          <div class="avatar" style="background:#dbeafe;">👩‍💼</div>
          <h3>Sarah Chen</h3>
          <p class="role">Founder &amp; CEO</p>
          <p class="bio">15 years in business consulting across retail, hospitality, and tech start-ups.</p>
        </div>
        <div class="team-card">
          <div class="avatar" style="background:#fef9c3;">👨‍💻</div>
          <h3>Marcus Obi</h3>
          <p class="role">Head of Digital</p>
          <p class="bio">Full-stack developer turned strategist with a passion for performance and accessibility.</p>
        </div>
        <div class="team-card">
          <div class="avatar" style="background:#dcfce7;">👩‍🎨</div>
          <h3>Priya Nair</h3>
          <p class="role">Creative Director</p>
          <p class="bio">Award-winning designer who believes great branding starts with a great story.</p>
        </div>
        <div class="team-card">
          <div class="avatar" style="background:#fce7f3;">🧑‍📈</div>
          <h3>James Walsh</h3>
          <p class="role">Marketing Lead</p>
          <p class="bio">Data-driven marketer who has helped 50+ local businesses double their online reach.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact Section -->
  <section id="contact">
    <div class="container">
      <h2 class="section-title">Get in Touch</h2>
      <p class="section-subtitle">We'd love to hear about your business</p>
      <div class="contact-grid">
        <div class="contact-info">
          <div class="contact-item">
            <span class="contact-icon">📍</span>
            <div>
              <strong>Office</strong>
              <p>42 Merchant Lane, Suite 3<br />Bristol, BS1 4LR</p>
            </div>
          </div>
          <div class="contact-item">
            <span class="contact-icon">📞</span>
            <div>
              <strong>Phone</strong>
              <p><a href="tel:+441170001234">+44 117 000 1234</a></p>
            </div>
          </div>
          <div class="contact-item">
            <span class="contact-icon">✉️</span>
            <div>
              <strong>Email</strong>
              <p><a href="mailto:hello@brightandco.example">hello@brightandco.example</a></p>
            </div>
          </div>
          <div class="contact-item">
            <span class="contact-icon">🕐</span>
            <div>
              <strong>Hours</strong>
              <p>Mon–Fri: 9 am – 6 pm<br />Sat: 10 am – 2 pm</p>
            </div>
          </div>
        </div>
        <form class="contact-form">
          <div class="form-group">
            <label for="name">Your Name</label>
            <input type="text" id="name" name="name" placeholder="Jane Smith" required />
          </div>
          <div class="form-group">
            <label for="email">Email Address</label>
            <input type="email" id="email" name="email" placeholder="jane@example.com" required />
          </div>
          <div class="form-group">
            <label for="message">Message</label>
            <textarea id="message" name="message" rows="5" placeholder="Tell us about your business and how we can help…" required></textarea>
          </div>
          <button type="submit" class="btn-primary">Send Message</button>
        </form>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer>
    <div class="container footer-inner">
      <p class="logo">Bright <span>&amp;</span> Co.</p>
      <p class="footer-copy">© 2025 Bright &amp; Co. · All rights reserved.</p>
      <ul class="footer-links">
        <li><a href="#about">About</a></li>
        <li><a href="#services">Services</a></li>
        <li><a href="#contact">Contact</a></li>
      </ul>
    </div>
  </footer>

</Layout>

<style>
  /* ── Navbar ── */
  header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--color-white);
    box-shadow: 0 1px 3px rgba(0,0,0,.08);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 4rem;
  }

  .logo {
    font-size: 1.375rem;
    font-weight: 800;
    color: var(--color-text);
    letter-spacing: -0.02em;
  }

  .logo span { color: var(--color-primary); }

  .nav-links {
    display: flex;
    gap: 2rem;
    list-style: none;
    align-items: center;
  }

  .nav-links a {
    font-weight: 500;
    color: var(--color-text);
  }

  .btn-nav {
    background: var(--color-primary);
    color: var(--color-white) !important;
    padding: 0.5rem 1.25rem;
    border-radius: 999px;
    font-weight: 600;
  }

  .btn-nav:hover {
    background: var(--color-primary-dark);
    text-decoration: none;
  }

  /* ── Hero ── */
  .hero {
    background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 100%);
    padding: 6rem 0;
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
  }

  .badge {
    display: inline-block;
    background: var(--color-primary);
    color: #fff;
    font-size: 0.8rem;
    font-weight: 600;
    padding: 0.25rem 0.875rem;
    border-radius: 999px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 1rem;
  }

  .hero-content h1 {
    font-size: clamp(2rem, 5vw, 3.25rem);
    font-weight: 800;
    line-height: 1.15;
    margin-bottom: 1.25rem;
    color: var(--color-text);
  }

  .highlight { color: var(--color-primary); }

  .hero-content p {
    font-size: 1.125rem;
    color: var(--color-muted);
    margin-bottom: 2rem;
    max-width: 42ch;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .btn-primary {
    background: var(--color-primary);
    color: var(--color-white);
    padding: 0.75rem 1.75rem;
    border-radius: 999px;
    font-weight: 600;
    border: none;
    cursor: pointer;
    font-size: 1rem;
    transition: background .2s;
  }

  .btn-primary:hover {
    background: var(--color-primary-dark);
    text-decoration: none;
    color: var(--color-white);
  }

  .btn-outline {
    background: transparent;
    color: var(--color-primary);
    padding: 0.75rem 1.75rem;
    border-radius: 999px;
    font-weight: 600;
    border: 2px solid var(--color-primary);
    transition: all .2s;
  }

  .btn-outline:hover {
    background: var(--color-primary);
    color: var(--color-white);
    text-decoration: none;
  }

  .hero-graphic {
    position: relative;
    height: 320px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .graphic-circle {
    position: absolute;
    border-radius: 50%;
  }

  .c1 {
    width: 280px;
    height: 280px;
    background: rgba(37,99,235,.12);
  }

  .c2 {
    width: 200px;
    height: 200px;
    background: rgba(245,158,11,.18);
    top: 20px;
    right: 30px;
  }

  .graphic-icon {
    font-size: 6rem;
    position: relative;
    z-index: 1;
    color: var(--color-primary);
    animation: spin 20s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  /* ── About ── */
  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: start;
  }

  .about-text p {
    margin-bottom: 1rem;
    color: var(--color-muted);
  }

  .about-highlights {
    list-style: none;
    margin-top: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-weight: 500;
  }

  .about-stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }

  .stat-card {
    background: var(--color-white);
    border-radius: var(--border-radius);
    padding: 1.5rem;
    text-align: center;
    box-shadow: 0 2px 8px rgba(0,0,0,.06);
  }

  .stat-number {
    display: block;
    font-size: 2rem;
    font-weight: 800;
    color: var(--color-primary);
  }

  .stat-label {
    font-size: 0.875rem;
    color: var(--color-muted);
  }

  /* ── Services ── */
  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .service-card {
    background: var(--color-white);
    border-radius: var(--border-radius);
    padding: 2rem 1.5rem;
    box-shadow: 0 2px 8px rgba(0,0,0,.06);
    transition: transform .2s, box-shadow .2s;
  }

  .service-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0,0,0,.1);
  }

  .service-icon {
    font-size: 2rem;
    margin-bottom: 1rem;
  }

  .service-card h3 {
    font-size: 1.125rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }

  .service-card p {
    color: var(--color-muted);
    font-size: 0.9375rem;
  }

  /* ── Team ── */
  .team-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }

  .team-card {
    background: var(--color-white);
    border-radius: var(--border-radius);
    padding: 2rem 1.5rem;
    text-align: center;
    box-shadow: 0 2px 8px rgba(0,0,0,.06);
  }

  .avatar {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2.25rem;
    margin: 0 auto 1rem;
  }

  .team-card h3 {
    font-weight: 700;
    margin-bottom: 0.25rem;
  }

  .role {
    font-size: 0.875rem;
    color: var(--color-primary);
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  .bio {
    font-size: 0.875rem;
    color: var(--color-muted);
  }

  /* ── Contact ── */
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: 3rem;
  }

  .contact-info {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .contact-item {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }

  .contact-icon {
    font-size: 1.5rem;
    flex-shrink: 0;
  }

  .contact-item strong {
    display: block;
    margin-bottom: 0.25rem;
  }

  .contact-item p {
    color: var(--color-muted);
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    background: var(--color-white);
    padding: 2rem;
    border-radius: var(--border-radius);
    box-shadow: 0 2px 8px rgba(0,0,0,.06);
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .form-group label {
    font-weight: 600;
    font-size: 0.9375rem;
  }

  .form-group input,
  .form-group textarea {
    border: 1.5px solid #e2e8f0;
    border-radius: 0.5rem;
    padding: 0.625rem 0.875rem;
    font-size: 1rem;
    font-family: var(--font-sans);
    transition: border-color .2s;
    background: var(--color-bg);
  }

  .form-group input:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--color-primary);
  }

  .form-group textarea {
    resize: vertical;
  }

  /* ── Footer ── */
  footer {
    background: var(--color-text);
    color: #94a3b8;
    padding: 2.5rem 0;
  }

  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
  }

  footer .logo {
    color: var(--color-white);
    font-size: 1.25rem;
  }

  footer .logo span { color: var(--color-accent); }

  .footer-copy {
    font-size: 0.875rem;
  }

  .footer-links {
    list-style: none;
    display: flex;
    gap: 1.5rem;
  }

  .footer-links a {
    color: #94a3b8;
    font-size: 0.875rem;
  }

  .footer-links a:hover { color: var(--color-white); }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    .hero-inner,
    .about-grid,
    .contact-grid {
      grid-template-columns: 1fr;
    }

    .hero-graphic { display: none; }

    .services-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .team-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .nav-links { display: none; }

    .services-grid,
    .team-grid {
      grid-template-columns: 1fr;
    }

    .about-stats {
      grid-template-columns: 1fr 1fr;
    }

    .footer-inner {
      flex-direction: column;
      text-align: center;
    }
  }
</style>
